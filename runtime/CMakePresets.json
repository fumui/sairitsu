{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host (clang, Ninja, RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
        "CMAKE_RC_COMPILER": "C:/Program Files/LLVM/bin/llvm-rc.exe"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a sr_tests (NDK 28.2.13676358, API 26, Ninja, RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "$env{LOCALAPPDATA}/Android/Sdk/ndk/28.2.13676358/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "26"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "android-arm64-tests", "configurePreset": "android-arm64", "targets": ["sr_tests"] }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    }
  ]
}
